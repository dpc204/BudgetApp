@page "/envelopes"

@rendermode InteractiveServer

<h1>Envelopes</h1>
@if (_loading)
{
  <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="pa-4">
    <MudProgressLinear Indeterminate="true" Color="Color.Primary"/>
  </MudStack>
}
else if (!string.IsNullOrEmpty(_loadError))
{
  <MudAlert Severity="Severity.Error">Failed to load: @_loadError</MudAlert>
}
else
{
  <MudStack Spacing="2" Class="d-flex flex-column" Style="height: 100%; overflow: hidden;">
    <MudPaper Elevation="0" Class="sb-property-border" Style="flex-shrink: 0;">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="pa-2">
          <MudSelect T="string?" Label="Choose Category" Variant="Variant.Outlined" dense="true"
                     @bind-Value="SelectedCategoryId" @bind-Value:after="@(() => _ = CatChanged(SelectedCategoryId))">
            @foreach (var c in CategoriesForSelect)
            {
              <MudSelectItem @key="c.CategoryId" Value="@(c.CategoryId)">@c.CategoryName</MudSelectItem>
            }
          </MudSelect >
        </MudStack >
      </MudPaper >
      <div style="flex: 1; min-height: 0; overflow: hidden; width: fit-content;">
        <MudDataGrid Items="@SelectedEnvelopeData"
                         Hover="true"
                         dense="true"
                         FixedHeader="true"
                         RowClassFunc="GetEnvelopeRowClass"
                         RowStyleFunc="GetEnvelopeRowStyle"
                         @bind-SelectedItem="SelectedEnvelope"
                       ExpandSingleRow="true"
                       Class="envelopes-table"
                       Style="height: 100%; overflow: auto; width: auto;">
            <Columns >
                <HierarchyColumn T="EnvelopeResult"/>

                <TemplateColumn Title="">
                  <CellTemplate Context="ctx">
                    <MudIconButton Icon="@Icons.Material.Filled.Add"
                                   Size="Size.Small"
                                   Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   OnClick="@(() => NewTransactionAsync(ctx.Item))"/>
                  </CellTemplate >
                </TemplateColumn >
                <PropertyColumn Property="x => x != null ? x.CategoryName : string.Empty" Title="Category" HeaderStyle="min-width: 16rem;"/>
                <PropertyColumn Property="x => x != null ? x.EnvelopeName : string.Empty" Title="Envelope" HeaderStyle="min-width: 16rem;"/>

                <TemplateColumn Title="Balance"
                                titleClass="text-end"
                                CellClass="text-end"
                                HeaderStyle="text-align: right;"
                                CellStyle="text-align: right;">
                  <CellTemplate Context="ctx">
                    @ctx.Item?.Balance.ToString("C2")
                  </CellTemplate >
                </TemplateColumn >
              </Columns >
              <ChildRowContent>
                <MudDataGrid T="FullTransactionDto" VirtualizeServerData="ServerData" Virtualize="false" Filterable FixedHeader Height="400px" ItemSize="52.68f">
                  <Columns>
                    <PropertyColumn Property="x => x" Title="Number"/>
                  </Columns>
                  <RowLoadingContent>
                    <tr class="mud-table-row">
                      <td class="mud-table-cell" colspan="1000">
                        Loading...
                      </td>
                    </tr>
                  </RowLoadingContent>
                </MudDataGrid>
              </ChildRowContent>
            </MudDataGrid >
          </div>
    </MudStack>
}