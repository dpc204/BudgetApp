@page "/fund"
@rendermode InteractiveServer
@inject IBudgetMonthlyApiClient BudgetMonthlyApi
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<style>
  .fund-input-right {
    width: 150px;
  }
  .fund-input-right input {
    text-align: right !important;
  }
  .fund-summary-text {
    font-size: 1.1rem;
    font-weight: 500;
  }
</style>

<PageTitle>Fund</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-1" Style="padding-left: 0; padding-right: 0;">
  <MudText Typo="Typo.h4" Class="mb-1">Fund Envelopes</MudText>

  @if (_loading)
  {
    <MudProgressLinear Indeterminate="true" />
  }
  else if (_fundData != null)
  {
    @if (_processing)
    {
      <MudProgressLinear Indeterminate="true"  />
    }

    <MudPaper Class="pa-4 mb-4">
      <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
          <MudMenu Label="Options" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Medium">
            <MudMenuItem OnClick="@(() => SetFillAmount(FillAmounts.OneHundredPercent))">Fill 100% of Budget</MudMenuItem>
            <MudMenuItem OnClick="@(() => SetFillAmount(FillAmounts.FiftyPercent))">Fill 50% of Budget</MudMenuItem>
          </MudMenu>
          
          <MudButton Variant="Variant.Filled" 
                    Color="Color.Primary" 
                    Size="Size.Medium"
                    OnClick="ApplyFillAmounts">
            @GetFillButtonText()
          </MudButton>

          <MudSelect T="DateTime" 
                    Value="@_selectedMonth" 
                    ValueChanged="@OnMonthChanged"
                    Variant="Variant.Outlined" 
                    AnchorOrigin="Origin.BottomCenter"
                    Style="min-width: 150px;">
            @foreach (var month in _monthOptions)
            {
              <MudSelectItem Value="@month">@month.ToString("MMM yy")</MudSelectItem>
            }
          </MudSelect>
        </MudStack>

        <MudStack Row="true" Spacing="4" AlignItems="AlignItems.Center">
          <MudText Class="fund-summary-text">Total Budget: @_totalBudget.ToString("C2")</MudText>
          <MudText Class="fund-summary-text">Total Balance: @_totalBalance.ToString("C2")</MudText>
          <MudText Class="fund-summary-text" Color="Color.Primary">Available to fund: @_availableToFund.ToString("C2")</MudText>
        </MudStack>
      </MudStack>
    </MudPaper>

    <MudTable Items="@_envelopeRows" Dense="true" Hover="true" Striped="true" Breakpoint="Breakpoint.None">
      <HeaderContent>
        <MudTh>Envelope Name</MudTh>
        <MudTh Style="text-align: right;">Current Balance</MudTh>
        <MudTh Style="text-align: right;">Budget</MudTh>
        <MudTh Style="text-align: right;">Fund Amount</MudTh>
      </HeaderContent>
      <RowTemplate>
        <MudTd DataLabel="Envelope Name">
          <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
            <MudText>@context.EnvelopeName</MudText>
            <MudMenu Icon="@Icons.Material.Filled.MoreVert" 
                    Size="Size.Small" 
                    Dense="true"
                    AnchorOrigin="Origin.BottomLeft">
              <MudMenuItem OnClick="@(() => FillToBudgetForPeriod(context.EnvelopeId))">Fill to Budget for Period</MudMenuItem>
              <MudMenuItem OnClick="@(() => AddFullBudgetAmountForPeriod(context.EnvelopeId))">Add Full Budget Amount for Period</MudMenuItem>
              <MudDivider />
              <MudMenuItem OnClick="@(() => ShowHelp())">Help</MudMenuItem>
            </MudMenu>
          </MudStack>
        </MudTd>
        <MudTd DataLabel="Current Balance" Style="text-align: right;">
          @context.CurrentBalance.ToString("C2")
        </MudTd>
        <MudTd DataLabel="Budget" Style="text-align: right;">
          @(context.Budget?.ToString("C2") ?? "$0.00")
        </MudTd>
        <MudTd DataLabel="Fund Amount" Style="text-align: right;">
          <MudNumericField T="decimal?" 
                          Value="@context.FundAmount" 
                          ValueChanged="@((decimal? val) => UpdateFundAmount(context.EnvelopeId, val))"
                          Format="C2"
                          HideSpinButtons="true"
                          Class="fund-input-right"
                          Variant="Variant.Text"
                          Margin="Margin.Dense" />
        </MudTd>
      </RowTemplate>
    </MudTable>
  }
</MudContainer>

