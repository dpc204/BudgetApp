@page "/assign"

@rendermode InteractiveServer


<h2>Unassigned Transactions</h2>
@if(_loading)
{
  <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="pa-4">
    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
  </MudStack>
}
else if(!string.IsNullOrEmpty(_loadError))
{
  <MudAlert Severity="Severity.Error">Failed to load: @_loadError</MudAlert>
}
else
{
  <MudProgressLinear Value="ProgressValue" Max="ProgressMax" Indeterminate="false" Color="Color.Primary" />

  <div style="flex: 1; min-height: 0; overflow: hidden; width: 100%;">
    <MudDataGrid T="TransactionDto"
                 @ref="Grid"
                 ReadOnly="false"
                 EditMode="DataGridEditMode.Cell"
                 Filterable="true"
                 FilterMode="DataGridFilterMode.ColumnFilterRow"
                 FilterCaseSensitivity="DataGridFilterCaseSensitivity.CaseInsensitive"
                 Bordered="true"
                 SortMode="SortMode.Multiple"
                 Dense="true"
                 ColumnResizeMode="ResizeMode.Column"
                 ServerData="LoadServerData"
                 FixedHeader="true"
                 Height="calc(100vh - 250px)"
                 MultiSelection="true"
                 Virtualize="true"
                 @bind-SelectedItems="_selectedTransactions"
                 RowStyleFunc="@GetRowStyle"
                 Class="envelopes-table"
                 Style="height: 100%; overflow: auto; width: auto ;">
      <Columns>
        <SelectColumn T="TransactionDto" />
        <PropertyColumn Property="x => x.Date"
                        Title="Date"
                        Format="d"
                        Filterable="false"
                        Sortable="true"
                        Editable="false" Resizable="true" />

        <PropertyColumn T="TransactionDto" TProperty="string" Property="x => x.Notes" Required="false">
        
          <EditTemplate>
            <MudTextField T="string"
                          Value="@context.Item.Notes"
                          ValueChanged="@(async (string val) => await OnNotesChanged(context.Item, val))"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="false" />
          </EditTemplate>
        </PropertyColumn>

        <TemplateColumn Title="Hide" Sortable="false" Filterable="false" Resizable="false" Editable="false">
          <CellTemplate>
            <div @onclick:stopPropagation>
              <MudCheckBox T="bool"
                           Value="@context.Item.TransactionHiddenFromAssign"
                           ValueChanged="@(async (bool val) => await OnHiddenChanged(context.Item, val))"
                           Dense="true" />
            </div>
          </CellTemplate>
        </TemplateColumn>

        <TemplateColumn Title="Envelope" Sortable="true" Filterable="false" SortBy="@(x => x.EnvelopeName)">
          <CellTemplate Context="cellContext">
            <div @onclick:stopPropagation>
              @cellContext.Item.EnvelopeName
            </div>
          </CellTemplate>
          <EditTemplate Context="editContext">
            <div @onclick:stopPropagation>
              <EnvelopePicker Value="@null"
                              ValueChanged="@(EventCallback.Factory.Create<EnvelopeIdName?>(this, val => HandleEnvelopeChanged(editContext.Item, val)))"
                              ShowCategoryInDisplay="true"
                              Placeholder="Search Envelope" />
            </div>
          </EditTemplate>
        </TemplateColumn>


        <PropertyColumn T="TransactionDto" TProperty="string" Property="x => x.Vendor" Required="false">
        
          <EditTemplate>
            <MudTextField T="string"
                          Value="@context.Item.Vendor"
                          ValueChanged="@(async (string val) => await OnVendorChanged(context.Item, val))"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="false" />
          </EditTemplate>
        </PropertyColumn>

        <PropertyColumn T="TransactionDto" TProperty="string" Property="x => x.Description" Required="false">
        
          <EditTemplate>
            <MudTextField T="string"
                          Value="@context.Item.Description"
                          ValueChanged="@(async (string val) => await OnDescriptionChanged(context.Item, val))"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="false" />
          </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Title="Amount"
                        Editable="false"
                        Sortable="true"
                        Filterable="false"
                        Format="N2"
                        CellStyle="text-align: right;"
                        HeaderStyle="text-align: right;"
                        SortBy="@(x => x.Amount)" Property="x => x.Amount" />
      </Columns>


      <ToolBarContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
          <EnvelopePicker Value="@_bulkEnvelope"
                          ValueChanged="@OnBulkEnvelopeSelected"
                          ShowCategoryInDisplay="true"
                          Placeholder="Select Envelope for Bulk Assignment"
                          Disabled="@(_selectedTransactions.Count == 0)"
                          Style="min-width: 300px;" />
          <MudButton Variant="Variant.Filled"
                     Color="Color.Primary"
                     Disabled="@(_selectedTransactions.Count == 0 || _bulkEnvelope is null)"
                     OnClick="BulkAssignAsync">
            Assign (@(_selectedTransactions.Count) selected)
          </MudButton>
        </MudStack>
        <MudSpacer />
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
          <MudCheckBox T="bool"
                       Value="@_showHidden"
                       ValueChanged="@(async (bool val) => await OnShowHiddenChangedAsync(val))"
                       Color="Color.Primary"
                       Dense="true"
                       Label="Show Hidden" />
          <MudButton Variant="Variant.Outlined"
                     Color="Color.Warning"
                     Size="Size.Small"
                     Disabled="@(_hiddenCount == 0)"
                     OnClick="ClearHiddenAsync">
            Clear (@_hiddenCount) Hidden
          </MudButton>
        </MudStack>
      </ToolBarContent>
      <PagerContent>
        <MudDataGridPager T="TransactionDto"
                          PageSizeOptions="new []{ 50, 100, 200}" />
      </PagerContent>
    </MudDataGrid>
  </div>
}