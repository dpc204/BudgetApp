@page "/allocation"
@rendermode InteractiveServer
@using System.Diagnostics
@using Budget.Shared
@using Budget.Shared.Models
@using Budget.Shared.Services
@using Budget.Shared.FDComponents
@using MudExtensions




<h1>Unallocated Transactions</h1>
@if (_loading)
{
  <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="pa-4">
    <MudProgressCircular Indeterminate="true" Color="Color.Primary"/>
  </MudStack>
}
else if (!string.IsNullOrEmpty(_loadError))
{
  <MudAlert Severity="Severity.Error">Failed to load: @_loadError</MudAlert>
}
else
{
  <MudContainer MaxWidth="MaxWidth.False" Class="pa-2 envelope-page-container">
    <MudPaper Elevation="0" Class="h-100 d-flex flex-column">
      <MudDataGrid T="TransactionDto"
                   Items="@Transactions"
                   ReadOnly="false"
                   EditMode="DataGridEditMode.Cell"
                   Hover="true"
                   Dense="true"
                   FixedHeader="true"
                   Height="@EnvelopeGridHeightPx"
                   RowClick="@((DataGridRowClickEventArgs<TransactionDto> args) => OnRowClicked(args))"
                   Class="envelopes-table">
        <Columns >
          <TemplateColumn Title="Date" Editable="false">
            <CellTemplate>@context.Item.Date.ToString("MM/dd/yy")</CellTemplate>
          </TemplateColumn>
          <TemplateColumn Title="EnvelopeMudE">
            <CellTemplate>
              @{
                var envelope = _availableEnvelopes.GetValueOrDefault(context.Item.EnvelopeId);
              }
              @envelope + "Envelope"
            </CellTemplate>
            <EditTemplate>

              <MudComboBox T="int" @bind-Value="@context.Item.EnvelopeId" 
                           @bind-Text="@context.Item.EnvelopeName" 
                           Variant="Variant.Filled" 
                           ToggleSelection="true" 
                           Clearable
                           Label="Custom (StartsWith)" 
                           Editable="true" 
                           SearchFunc="@(new Func<int, string?, string?, bool>(SearchEnvelopeName))" 
                           >
                @foreach (var c in _availableEnvelopes)
                {
                  <MudComboBoxItem Value="c.Key" Text="@((string)c.Value.Name)">@c.Value.Name</MudComboBoxItem>
                }
              </MudComboBox>


              <MudSelect T="int?" Variant="Variant.Outlined" Dense="true">
                @foreach (var c in _availableEnvelopes)
                {
                  <MudSelectItem @key="c.Key" Value="@((int?)c.Key)">@c.Value</MudSelectItem>
                }
              </MudSelect>

            </EditTemplate>

          </TemplateColumn>

          <TemplateColumn Title="Vendor" Editable="false">
            <CellTemplate>@context.Item.Vendor</CellTemplate>
          </TemplateColumn>
          <TemplateColumn Title="Description" Editable="false">
            <CellTemplate>@context.Item.Description</CellTemplate>
          </TemplateColumn>
          <TemplateColumn Title="Amount" Editable="false">
            <CellTemplate>@context.Item.Amount.ToString("C2")</CellTemplate>
          </TemplateColumn>
        </Columns >
      </MudDataGrid >
    </MudPaper >
  </MudContainer>
}