<MudStack Spacing="2">
  <MudText Typo="Typo.h6">Import Transactions (CSV)</MudText>

  <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
    <MudSelect T="int" Label="Account" @bind-Value="SelectedAccountId" Disabled="Busy" dense="true" Class="w-300">
      @foreach (var acct in Accounts)
      {
        <MudSelectItem T="int" Value="@acct.Id">@acct.Name (@acct.Balance.ToString("C"))</MudSelectItem>
      }
    </MudSelect>

    <MudTextField @bind-Value="UserIdText" Label="User Id" Disabled="Busy" dense="true" Class="w-150"/>

    <InputFile OnChange="OnInputFileChange" accept=".csv"/>

    <MudButton OnClick="ImportAsync" Disabled="Busy || SelectedFile is null || SelectedAccountId == 0 || ParsedRowsCount == 0" Variant="Variant.Filled" Color="Color.Primary">Import</MudButton>
  </MudStack>

  @if (!string.IsNullOrEmpty(Status))
  {
    <MudText>@Status</MudText>
  }

  @if (Busy)
  {
    <MudProgressCircular Color="Color.Primary" Value="@Value" Size="Size.Large">
      <ChildContent>
        @Value %
      </ChildContent>
    </MudProgressCircular>
  }

  @if (Errors.Count > 0)
  {
    <MudAlert Severity="Severity.Error">
      <ul>
        @foreach (var err in Errors)
        {
          <li>@err</li>
        }
      </ul>
    </MudAlert>
  }

  @if (Preview.Count > 0)
  {
    <MudTable Items="Preview" dense="true" Hover="true" Bordered="true" Elevation="0">
      <HeaderContent>
        <MudTh>Date</MudTh>
        <MudTh>Vendor</MudTh>
        <MudTh>Description</MudTh>
        <MudTh class="text-end">Amount</MudTh>
        <MudTh>Envelope</MudTh>
      </HeaderContent>
      <RowTemplate>
        <MudTd DataLabel="Date">@context.Date.ToShortDateString()</MudTd>
        <MudTd DataLabel="Vendor">@context.Vendor</MudTd>
        <MudTd DataLabel="Description">@context.Description</MudTd>
        <MudTd DataLabel="Amount" Class="text-end">@context.Amount</MudTd>
        <MudTd DataLabel="Envelope">@context.EnvelopeId</MudTd>
      </RowTemplate>
    </MudTable>
  }
</MudStack>