@page "/import"
<MudStack Spacing="2" Class="d-flex flex-column" Style="height: 100%; overflow: hidden;">

  <MudText Typo="Typo.h6">Import Transactions (CSV)</MudText>

  <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
    <MudSelect T="int" Label="Account" @bind-Value="SelectedAccountId" Disabled="Busy" dense="true" Class="w-300">
      @foreach (var acct in Accounts)
      {
        <MudSelectItem T="int" Value="@acct.Id">@acct.Name (@acct.Balance.ToString("C"))</MudSelectItem>
      }
    </MudSelect>

    <MudTextField @bind-Value="UserIdText" Label="User Id" Disabled="Busy" dense="true" Class="w-150"/>

    <InputFile OnChange="OnInputFileChange" accept=".csv"/>

    <MudText>Filename:&nbsp;@Busy.ToString()</MudText>

    @* <MudButton OnClick="ImportAsync" Disabled="Busy || SelectedFile is null || SelectedAccountId == 0 || ParsedRowsCount == 0" Variant="Variant.Filled" Color="Color.Primary">Import</MudButton> *@
  </MudStack>

  @if (!string.IsNullOrEmpty(Status))
  {
    <MudText>@Status</MudText>
  }

  @if (Busy)
  {
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Striped="true" Size="Size.Large"/>
  }

  @if (Errors.Count > 0)
  {
    <MudAlert Severity="Severity.Error">
      <ul>
        @foreach (var err in Errors)
        {
          <li>@err</li>
        }
      </ul>
    </MudAlert>
  }

  @if (Preview.Count > 0)
  {
    <div style="flex: 1; min-height: 0; overflow: hidden; width: fit-content;">
      <MudDataGrid T="TransactionImportDto"
                   Items="@Preview"
                   Filterable="true"
                   FilterMode="DataGridFilterMode.ColumnFilterMenu"
                   SortMode="SortMode.Multiple"
                   Dense="true"
                   Hover="true"
                   Bordered="true"
                   Sortable="true"
                   FixedHeader="true"
                   Style="height: 100%; overflow: auto; width: auto;">
      @*   <ColGroup>
          <col style="width: 50px;"/>
          <col style="width: 50px;"/>
          <col style="width: 50px;"/>
          <col style="width: 50px;"/>
          <col style="width: 50px;"/>
          <col style="width: 50px;"/>
        </ColGroup> *@
        <ToolBarContent >
           <MudButton OnClick="DeleteStagedTransactionsAsync" Class="border-solid border-2 mud-border-primary ma-4" Elevation="0" Disabled="Busy || Preview.Count == 0">Delete Staged Transactions</MudButton>
          <MudButton OnClick="ImportAsync" Disabled="Busy || Preview.Count == 0  " Class="border-solid border-2 mud-border-primary ma-4" Elevation="0">Import Transactions</MudButton>
        </ToolbarContent>
        <Columns>
          <PropertyColumn Property="x => x.Date"
                          Title="Date"
                          Format="d"
                          Filterable="true"
                          Sortable="true"/>

          <PropertyColumn Property="x => x.Vendor"
                          Title="Vendor"
                          Filterable="true"
                          Sortable="true"/>

          <PropertyColumn Property="x => x.Description"
                          Title="Description"
                          Filterable="true"
                          Sortable="true"/>

          <PropertyColumn Property="x => x.Amount"
                          Title="Amount"
                          Format="C"
                          Filterable="true"
                          Sortable="true"
                          CellStyle="text-align: right;"
                          HeaderStyle="text-align: right;"/>

          <TemplateColumn Title="Duplicate/Keep Dup."
                          Filterable="false"
                          Sortable="true"
                          SortBy="@(x => x.Duplicate)"
                          HeaderStyle=" text-align: left;"
                          CellStyle=" text-align: left;">
            <CellTemplate>
              <MudStack Row="true">
              <MudCheckBox T="bool" Value="@context.Item.Duplicate"
                           Color="Color.Warning"
                           ReadOnly="true"
                           Disabled="Busy"/>
              /
              <MudCheckBox T="bool"
                           Value="@context.Item.KeepDuplicate"
                           Color="Color.Warning"
                           ReadOnly="false"
                           Disabled="@(!context.Item.Duplicate || Busy)"
                           ValueChanged="@(async (bool value) =>
                                         {
                                           context.Item.KeepDuplicate = value;
                                           await UpdateTransaction(context.Item);
                                         })"/>
            </MudStack>
            </CellTemplate>
          </TemplateColumn>

       
        </Columns>
      </MudDataGrid>
    </div>
  }
</MudStack>