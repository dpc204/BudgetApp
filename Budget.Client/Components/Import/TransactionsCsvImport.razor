@page "/import"
<MudStack Spacing="2">
  <MudText Typo="Typo.h6">Import Transactions (CSV)</MudText>

  <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
    <MudSelect T="int" Label="Account" @bind-Value="SelectedAccountId" Disabled="Busy" dense="true" Class="w-300">
      @foreach (var acct in Accounts)
      {
        <MudSelectItem T="int" Value="@acct.Id">@acct.Name (@acct.Balance.ToString("C"))</MudSelectItem>
      }
    </MudSelect>

    <MudTextField @bind-Value="UserIdText" Label="User Id" Disabled="Busy" dense="true" Class="w-150"/>

    <InputFile OnChange="OnInputFileChange" accept=".csv"/>

    <MudButton OnClick="ImportAsync" Disabled="Busy || SelectedFile is null || SelectedAccountId == 0 || ParsedRowsCount == 0" Variant="Variant.Filled" Color="Color.Primary">Import</MudButton>
  </MudStack>

  @if (!string.IsNullOrEmpty(Status))
  {
    <MudText>@Status</MudText>
  }

  @if (Busy)
  {
    <MudProgressCircular Color="Color.Primary" Value="@Value" Size="Size.Large">
      <ChildContent>
        @Value %
      </ChildContent>
    </MudProgressCircular>
  }

  @if (Errors.Count > 0)
  {
    <MudAlert Severity="Severity.Error">
      <ul>
        @foreach (var err in Errors)
        {
          <li>@err</li>
        }
      </ul>
    </MudAlert>
  }

  @if (Preview.Count > 0)
  {
    <MudDataGrid T="TransactionImportDto" 
                 Items="@Preview" 
                 Filterable="true"
                 FilterMode="DataGridFilterMode.ColumnFilterRow"
                 SortMode="SortMode.Multiple"
                 Dense="true" 
                 Hover="true" 
                 Bordered="true" 
                 FixedHeader="true"
                 Height="600px">
      <Columns>
        <PropertyColumn Property="x => x.Date" 
                       Title="Date" 
                       Format="d"
                       Filterable="true" 
                       Sortable="true" />
        
        <PropertyColumn Property="x => x.Vendor" 
                       Title="Vendor" 
                       Filterable="true" 
                       Sortable="true" />
        
        <PropertyColumn Property="x => x.Description" 
                       Title="Description" 
                       Filterable="true" 
                       Sortable="true" />
        
        <PropertyColumn Property="x => x.Amount" 
                       Title="Amount"
                       Format="C"
                       Filterable="true" 
                       Sortable="true"
                       CellClass="text-end"
                       HeaderStyle="text-align: right;" />
        
        <PropertyColumn Property="x => x.EnvelopeName" 
                       Title="Envelope" 
                       Filterable="true" 
                       Sortable="true" />
        
        <TemplateColumn Title="Duplicate" 
                       Filterable="false" 
                       Sortable="true"
                       SortBy="@(x => x.Duplicate)">
          <CellTemplate>
            <MudCheckBox Value="@context.Item.Duplicate" 
                        Color="Color.Warning" 
                        ValueChanged="@(async (bool value) => { context.Item.Duplicate = value; await OnDuplicateToggled(context.Item); })"
                        Disabled="Busy" />
          </CellTemplate>
        </TemplateColumn>
      </Columns>
    </MudDataGrid>
  }
</MudStack>