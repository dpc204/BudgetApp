@using System.Globalization
@inject ITransactionsApiClient BudgetApi
@inject IUserAndOptions UserOptions

<style>
  .draft-input-right { width: 100px; }

  .draft-input-right input { text-align: right !important; }

  .display-field-right input { text-align: right !important; }
</style>

<MudDialog ContentClass="pa-2">
  <DialogContent >
    <MudForm @ref="_form" Model="_header">
      <MudGrid Class="mb-2" Spacing="0">

        <MudItem xs="12" md="2">
          <MudDatePicker @bind-Date="HeaderDate" Label="Date" MaxDate="@DateTime.Today" Disabled="true" style="width: 150px;" RelativeWidth="DropdownWidth.Adaptive"/>
        </MudItem>

        <MudItem xs="3" md="2">
          <MudSelect T="int" @bind-Value="_header.AccountId" Label="Account" id="AccountSelect" Disabled="@IsVoided">
            @foreach (var e in Accounts.Where(a=> a.AccountType >= 0))
            {
              <MudSelectItem Value="@e.Id">@e.Name</MudSelectItem>
            }
          </MudSelect>
        </MudItem>
        <MudSpacer />
        &nbsp;&nbsp;
        <MudItem md="1" />
        <MudItem xs="12" md="1">
          <MudTextField T="decimal" Value="EditTotalAmount" Label="Edit Total" tabindex="-1" ReadOnly="true" Underline="false" Immediate="true" Class="display-field-right" />
        </MudItem>
        &nbsp;&nbsp;
        <MudItem md="1" />
        <MudItem xs="12" md="1">
          <MudTextField T="decimal" Value="EditDifference" Label="Difference" tabindex="-1" ReadOnly="true" Underline="false" Immediate="true" Class="display-field-right" />
        </MudItem>
        &nbsp;&nbsp;
        <MudItem md="1" />
        <MudItem xs="12" md="1">
          <MudTextField T="decimal" Value="_header.TotalAmount" Label="Tran. Total" tabindex="-1" Underline="false" ReadOnly="true" Class="display-field-right" />
        </MudItem>
    
        <MudFlexBreak/>
        <MudItem xs="12" md="4">
          <MudTextField @ref="_vendorField" T="string" @bind-Value="_header.Vendor" Label="Vendor" Required="true" Immediate="true" Disabled="@IsVoided"/>
        </MudItem>
        &nbsp&nbsp&nbsp
        <MudItem xs="12" md="4">
          <MudTextField @ref="_descriptionField" T="string" @bind-Value="_header.Description" Label="Description" Required="false" Immediate="true" Disabled="@IsVoided" />
        </MudItem>

      </MudGrid>

      @* Show at most 5 visible data rows (dense mode) with a scrollable body instead of paging *@
      <MudTable Items="@_lines" dense="true" Hover="true" FixedHeader="true" Height="230px" Class="mt-5">
        <HeaderContent>
          <MudTh>Envelope</MudTh>
          <MudTh class="text-end">Amount</MudTh>
          <MudTh>Note</MudTh>
          <MudTh style="width: 90px;"></MudTh>
        </HeaderContent>
        <RowTemplate>
          <MudTd>
            <MudSelect T="int" @bind-Value="context.EnvelopeId" dense="true" Disabled="@IsVoided">
              @foreach (var e in Envelopes)
              {
                <MudSelectItem Value="@e.Id">@e.Name</MudSelectItem>
              }
            </MudSelect>
          </MudTd>
          @* <MudTd Class="text-end" xs="5" md="5">
            <MudNumericField T="decimal"
                             @bind-Value="context.Amount"
                             For="@(() => context.Amount)"
                             @bind-Value:after="() => NormalizeAmount(context)"
                             Immediate="true"
                             Min="0.01m"
                             Format="N2"
                             Culture="@CultureInfo.CurrentCulture"
                             HideSpinButtons="true"
                             Validation="@((decimal val) => ValidateAmount(val))"
                             Disabled="@IsVoided"/>


          </MudTd> *@
          <MudTd>
            <MudNumericField T="decimal"
                             @bind-Value="context.Amount"
                             For="@(() => context.Amount)"
                             @bind-Value:after="() => NormalizeAmount(context)"
                             Validation="@((decimal val) => ValidateAmount(val))"
                             Format="C2"
                             Immediate="false"
                             HideSpinButtons="true"
                             Class="draft-input-right"
                             Variant="Variant.Text"
                             Margin="Margin.Dense"
                             Disabled="@IsVoided"/>
          </MudTd>
          <MudTd>
            <MudTextField @bind-Value="context.Description" Immediate="true" Placeholder="Note (optional)" Disabled="@IsVoided"/>
          </MudTd>
          <MudTd Class="text-end">
            <MudIconButton Icon="@Icons.Material.Filled.Remove" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                           OnClick="@(() => DeleteLine(context))" Disabled="@(_lines.Count <= 1 || IsVoided)"/>
          </MudTd>
        </RowTemplate>
        <NoRecordsContent>
          <MudText Class="pa-2" Color="Color.Secondary">No line items. Click Add to begin.</MudText>
        </NoRecordsContent>
      </MudTable>
    </MudForm>
  </DialogContent>
  <DialogActions>
    <MudGrid Justify="Justify.SpaceBetween" alignItems="AlignItems.Center">
      <MudItem xs="5">
        @if (!IsEditMode || (!IsVoided && IsEditMode && UserOptions.IsAdminUser()))
        {
          <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddLine">Add Line</MudButton>
        }
      </MudItem>
      <MudItem xs="2">
        @if (IsVoided)
        {
          <MudText Color="Color.Error">Void</MudText>
        }
      </MudItem>
      <MudItem xs="5">
        <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
          @if (!IsVoided && !IsReadOnly && IsEditMode && UserOptions.IsAdminUser())
          {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Error"
                       Style="background-color: red; color: white;"
                       OnClick="VoidTransaction">
              Void
            </MudButton>
          }
          <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="Cancel">Cancel</MudButton>
          @if (!IsVoided && !IsReadOnly)
          {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@IsSaveDisabled" OnClick="Save">@SaveButtonText</MudButton>
          }
        </MudStack>
      </MudItem>
    </MudGrid>
  </DialogActions>
</MudDialog>

<style>
  .purchase-dialog .e-dlg-content { padding-top: .75rem; }

  .purchase-dialog table td { vertical-align: middle; }
</style>