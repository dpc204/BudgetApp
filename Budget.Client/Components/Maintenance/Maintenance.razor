@page "/maintenance"
@attribute [Authorize]
@using Budget.Client.Components.Maintenance.AccountCRUD
@using Budget.Client.Components.Maintenance.CategoryCRUD
@using Budget.Client.Components.Maintenance.EnvelopePagesCRUD
@using Budget.Client.Components.Maintenance.BackupRestore
@using Budget.Client.Components.Maintenance.BacpacHistory
@using Budget.Client.Components.Import

<MudText Typo="Typo.h5" Class="mb-4">Maintenance</MudText>

@if (!string.IsNullOrWhiteSpace(Status))
{
    <MudAlert Severity="Severity.Info" Class="mb-2">@Status</MudAlert>
}

<MudTabs Elevation="1" Rounded="true">
    <MudTabPanel Text="Accounts">
        <AccountIndex />
    </MudTabPanel>
    <MudTabPanel Text="Categories">
        <CategoryIndex />
    </MudTabPanel>
    <MudTabPanel Text="Envelopes">
        <EnvelopeIndex />
    </MudTabPanel>
    <MudTabPanel Text="Import">
        <TransactionsCsvImport />
    </MudTabPanel>
    <MudTabPanel Text="Backup/Restore">
        <BackupRestoreIndex />
    </MudTabPanel>
    <MudTabPanel Text="BACPAC History">
        <BacpacHistoryIndex />
    </MudTabPanel>
    <MudTabPanel Text="Users">
        <div>Content of tab3</div>
    </MudTabPanel>
</MudTabs>