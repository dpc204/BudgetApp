@page "/maintenance"
@using Budget.Client.Components.Maintenance.AccountCRUD
@using Budget.Client.Components.Maintenance.CategoryCRUD
@using Budget.Client.Components.Maintenance.EnvelopePagesCRUD
@using Budget.Client.Components.Import

<MudText Typo="Typo.h5" Class="mb-4">Maintenance</MudText>

<MudStack Row="true" Spacing="2" Class="mb-4" AlignItems="AlignItems.Center">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="TriggerBackupAsync" Disabled="@Busy">
        @ButtonText
    </MudButton>
    @if (IsAdmin)
    {
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="TriggerBackupAllTablesAsync" Disabled="@BackupAllBusy">
            @BackupAllButtonText
        </MudButton>
    }
    @if (Busy)
    {
        <MudProgressCircular Indeterminate="true" Size="Size.Medium" Color="Color.Primary" />
    }
    @if (BackupAllBusy)
    {
        <MudProgressCircular Indeterminate="true" Size="Size.Medium" Color="Color.Secondary" />
    }
</MudStack>

@if (!string.IsNullOrWhiteSpace(Status))
{
    <MudAlert Severity="Severity.Info" Class="mb-2">@Status</MudAlert>
}
@if (!string.IsNullOrWhiteSpace(BackupAllStatus))
{
    <MudAlert Severity="Severity.Info" Class="mb-2">@BackupAllStatus</MudAlert>
}

<MudTabs Elevation="1" Rounded="true">
    <MudTabPanel Text="Accounts">
        <AccountIndex />
    </MudTabPanel>
    <MudTabPanel Text="Categories">
        <CategoryIndex />
    </MudTabPanel>
    <MudTabPanel Text="Envelopes">
        <EnvelopeIndex />
    </MudTabPanel>
    <MudTabPanel Text="Import">
        <TransactionsCsvImport />
    </MudTabPanel>
    <MudTabPanel Text="Users">
        <div>Content of tab3</div>
    </MudTabPanel>
</MudTabs>