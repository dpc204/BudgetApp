@using System.Diagnostics
@using Budget.Client.Components.Shared
@using Budget.Shared.Models
@using Budget.Shared.Services
@inject IBudgetMaintApiClient MaintApi
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudText Typo="Typo.h5" Class="mb-2">Envelopes</MudText>

<MudStack Spacing="2" Class="mb-4">
  <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" OnClick="ShowCreate">New</MudButton>
    
    <InputFile OnChange="OnInputFileChange" accept=".csv" disabled="@Busy"/>
    <MudButton OnClick="ImportAsync" 
               Disabled="@(Busy || SelectedFile is null)" 
               Variant="Variant.Filled" 
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Upload">
      Import Envelopes
    </MudButton>
  </MudStack>

  @if (!string.IsNullOrEmpty(Status))
  {
    <MudAlert Severity="@StatusSeverity">@Status</MudAlert>
  }

  @if (Busy)
  {
    <MudProgressLinear Indeterminate="true" Color="Color.Primary"/>
  }

  @if (Errors.Count > 0)
  {
    <MudAlert Severity="Severity.Error">
      <ul>
        @foreach (var err in Errors)
        {
          <li>@err</li>
        }
      </ul>
    </MudAlert>
  }
</MudStack>

<MudDataGrid T="EnvelopeDto"
             Items="@_envelopes"
             Hover="true"
             Dense="true"
             FixedHeader="true"
             Class="envelopes-table"
             ReadOnly="false"
             EditMode="DataGridEditMode.Cell">
  <Columns>
    <PropertyColumn Property="x => x.Id" Title="Env. Id" Editable="false" />

    <TemplateColumn T="EnvelopeDto" Title="Category" Editable="true">
      <CellTemplate Context="ctx">
        @_categoryLookup.GetValueOrDefault(ctx.Item.CategoryId)
      </CellTemplate>
      <EditTemplate Context="ctx">
        <MudSelect T="int" Value="ctx.Item.CategoryId" ValueChanged="@((int val) => OnCategoryChanged(ctx.Item, val))" Dense="true">
          @foreach (var c in _categoryLookup)
          {
            <MudSelectItem Value="@c.Key">@c.Value</MudSelectItem>
          }
        </MudSelect>
      </EditTemplate>
    </TemplateColumn>

    <TemplateColumn T="EnvelopeDto" Title="Envelope" HeaderStyle="min-width:16rem;" Editable="true">
      <CellTemplate Context="ctx">
        @ctx.Item.Name
      </CellTemplate>
      <EditTemplate Context="ctx">
        <MudTextField T="string" Value="ctx.Item.Name" ValueChanged="@((string val) => OnNameChanged(ctx.Item, val))" Dense="true" />
      </EditTemplate>
    </TemplateColumn>
   
    <TemplateColumn T="EnvelopeDto" Title="Balance"
                    CellClass="text-end"
                    HeaderStyle="text-align: right;"
                    CellStyle="text-align: right;"
                    Editable="false">
      <CellTemplate Context="ctx">
        @ctx.Item.Balance.ToString("C2")
      </CellTemplate>
    </TemplateColumn>
    
    <TemplateColumn T="EnvelopeDto" Title="Budget"
                    CellClass="text-end"
                    HeaderStyle="text-align: right;"
                    CellStyle="text-align: right;"
                    Editable="false">
      <CellTemplate Context="ctx">
        @ctx.Item.Budget.ToString("N2")
      </CellTemplate>
    </TemplateColumn>

    <TemplateColumn T="EnvelopeDto" Title="" CellStyle="width: 50px;" Editable="false">
      <CellTemplate Context="ctx">
        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                       Size="Size.Small"
                       Color="Color.Error"
                       OnClick="@(() => BeginDeleteAsync(ctx.Item))" />
      </CellTemplate>
    </TemplateColumn>
  </Columns>
  <NoRecordsContent>
    <MudText Class="pa-4" Color="Color.Secondary">No envelopes</MudText>
  </NoRecordsContent>
</MudDataGrid>

<MudStack Row="true" Spacing="2" Class="mt-4" Justify="Justify.FlexEnd">
  <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="CancelChanges" Disabled="@(!HasPendingChanges || Busy)">Cancel</MudButton>
  <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="UpdateChangesAsync" Disabled="@(!HasPendingChanges || Busy)">Update</MudButton>
</MudStack>

@code {
  private List<EnvelopeDto>? _envelopes;
  private List<EnvelopeDto>? _originalEnvelopes;
  private Dictionary<int, string> _categoryLookup = new();
  private HashSet<int> _changedEnvelopeIds = new();
  
  private bool HasPendingChanges => _changedEnvelopeIds.Count > 0;

  protected bool Busy { get; set; }
  protected string Status { get; set; } = string.Empty;
  protected Severity StatusSeverity { get; set; } = Severity.Info;
  protected IBrowserFile? SelectedFile { get; set; }
  protected List<string> Errors { get; } = [];

  protected override async Task OnInitializedAsync() => await LoadAsync();

  private async Task LoadAsync()
  {
    var categories = await MaintApi.GetCategoriesAsync();
    _categoryLookup = categories.ToDictionary(c => c.Id, c => c.Name);
    _envelopes = (await MaintApi.GetEnvelopesDtoAsync()).OrderBy(e => e.SortOrder).ThenBy(e => e.Name).ToList();
    _originalEnvelopes = _envelopes.Select(CloneEnvelope).ToList();
    _changedEnvelopeIds.Clear();
  }

  private static EnvelopeDto CloneEnvelope(EnvelopeDto e) => new()
  { 
    Id = e.Id, 
    CategoryId = e.CategoryId, 
    Name = e.Name, 
    Budget = e.Budget, 
    Balance = e.Balance, 
    Description = e.Description, 
    SortOrder = e.SortOrder 
  };

  private string GetCategoryName(int id) => _categoryLookup.TryGetValue(id, out var name) ? name : string.Empty;

  private void MarkAsChanged(EnvelopeDto item) => _changedEnvelopeIds.Add(item.Id);

  private void OnCategoryChanged(EnvelopeDto item, int newCategoryId)
  {
    item.CategoryId = newCategoryId;
    MarkAsChanged(item);
  }

  private void OnNameChanged(EnvelopeDto item, string newName)
  {
    item.Name = newName;
    MarkAsChanged(item);
  }

  private void CancelChanges()
  {
    if (_originalEnvelopes is null || _envelopes is null) return;
    
    foreach (var changedId in _changedEnvelopeIds)
    {
      var original = _originalEnvelopes.FirstOrDefault(e => e.Id == changedId);
      var current = _envelopes.FirstOrDefault(e => e.Id == changedId);
      if (original is not null && current is not null)
      {
        current.CategoryId = original.CategoryId;
        current.Name = original.Name;
      }
    }
    _changedEnvelopeIds.Clear();
  }

  private async Task UpdateChangesAsync()
  {
    if (_envelopes is null) return;
    
    Busy = true;
    try
    {
      var changedEnvelopes = _envelopes.Where(e => _changedEnvelopeIds.Contains(e.Id)).ToList();
      foreach (var envelope in changedEnvelopes)
      {
        await MaintApi.UpdateAsync(envelope);
      }
      
      Snackbar.Add($"Successfully updated {changedEnvelopes.Count} envelope(s).", Severity.Success);
      await LoadAsync();
    }
    catch (Exception ex)
    {
      Snackbar.Add($"Update failed: {ex.Message}", Severity.Error);
    }
    finally
    {
      Busy = false;
    }
  }

  private async Task BeginDeleteAsync(EnvelopeDto envelope)
  {
    // Check if the envelope has associated transactions
    var transactionCount = await MaintApi.GetEnvelopeTransactionCountAsync(envelope.Id);
    
    if (transactionCount > 0)
    {
      // Show error dialog - cannot delete envelope with transactions
      var options = new DialogOptions { MaxWidth = MaxWidth.Small, CloseButton = true };
      await DialogService.ShowMessageBox(
        "Cannot Delete Envelope",
        $"The envelope \"{envelope.Name}\" has {transactionCount} transaction(s) assigned to it and cannot be deleted. Please reassign or remove the transactions first.",
        yesText: "OK");
      return;
    }
    
    // Show confirmation dialog
    var confirmed = await DialogService.ShowMessageBox(
      "Delete Envelope",
      $"Are you sure you want to delete the envelope \"{envelope.Name}\"? This action cannot be undone.",
      yesText: "Delete",
      cancelText: "Cancel");
    
    if (confirmed == true)
    {
      try
      {
        var deleted = await MaintApi.RemoveEnvelopeAsync(envelope.Id);
        if (deleted)
        {
          Snackbar.Add($"Envelope \"{envelope.Name}\" deleted successfully.", Severity.Success);
          await LoadAsync();
        }
        else
        {
          Snackbar.Add($"Failed to delete envelope \"{envelope.Name}\".", Severity.Error);
        }
      }
      catch (Exception ex)
      {
        Snackbar.Add($"Delete failed: {ex.Message}", Severity.Error);
      }
    }
  }

  private async Task ShowCreate()
  {
    var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
    var dialogRef = await DialogService.ShowAsync<EnvelopeCreate>("Create Envelope", options);
    var result = await dialogRef.Result;
    if (result is not null && !result.Canceled)
      await LoadAsync();
  }

  protected async Task OnInputFileChange(InputFileChangeEventArgs e)
  {
    Errors.Clear();
    Status = string.Empty;
    SelectedFile = e.File;

    if (SelectedFile is null)
    {
      return;
    }

    if (!SelectedFile.Name.EndsWith(".csv", StringComparison.OrdinalIgnoreCase))
    {
      Errors.Add("Only .csv files are supported.");
      SelectedFile = null;
      return;
    }

    Status = $"Selected: {SelectedFile.Name}";
    StatusSeverity = Severity.Info;
  }

  protected async Task ImportAsync()
  {
    if (SelectedFile is null)
    {
      return;
    }

    Busy = true;
    Errors.Clear();
    Status = "Reading file...";
    StatusSeverity = Severity.Info;
    await InvokeAsync(StateHasChanged);

    try
    {
      await using var stream = SelectedFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
      using var reader = new StreamReader(stream, Encoding.UTF8, detectEncodingFromByteOrderMarks: true);
      var csvContent = await reader.ReadToEndAsync();

      Status = "Importing envelopes...";
      await InvokeAsync(StateHasChanged);

      var result = await MaintApi.ImportEnvelopesAsync(csvContent);

      if (result.Errors.Count > 0)
      {
        Errors.AddRange(result.Errors);
        Status = $"Import completed with errors. {result.ImportedCount} envelope(s) imported.";
        StatusSeverity = Severity.Warning;
      }
      else
      {
        Status = $"Successfully imported {result.ImportedCount} envelope(s).";
        StatusSeverity = Severity.Success;
        Snackbar.Add(Status, Severity.Success);
        
        // Refresh the data
        await LoadAsync();
      }

      SelectedFile = null;
    }
    catch (Exception ex)
    {
      Errors.Add($"Import failed: {ex.Message}");
      Status = "Import failed.";
      StatusSeverity = Severity.Error;
    }
    finally
    {
      Busy = false;
      await InvokeAsync(StateHasChanged);
    }
  }
}