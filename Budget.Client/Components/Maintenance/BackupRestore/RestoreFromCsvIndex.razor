<MudText Typo="Typo.h6" Class="mb-3">Restore Tables From CSV Backup</MudText>

@if (IsAdmin)
{
    <MudStack Row="false" Spacing="2" Class="mb-4">
        <MudText Typo="Typo.subtitle2">Target Database</MudText>
        <MudSelect T="string" @bind-Value="_targetDatabase" Label="Restore To" Variant="Variant.Outlined" Style="max-width: 220px;" Disabled="@RestoreBusy">
            @foreach (var option in DatabaseOptions)
            {
                <MudSelectItem Value="@option.Value">@option.Label</MudSelectItem>
            }
        </MudSelect>
    </MudStack>
}

<MudText Typo="Typo.subtitle1" Class="mb-2 mt-4">Backup Sets</MudText>

@if (_backupSets == null)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_backupSets.Count == 0)
{
    <MudAlert Severity="Severity.Info">No backup sets found</MudAlert>
}
else
{
    <MudDataGrid T="BackupSetDto" Items="_backupSets" Dense="true" Class="mb-4" Style="width: auto; max-width: fit-content;">
        <Columns>
            <PropertyColumn Property="x => x.PartitionKey" Title="Backup Name" />
            <PropertyColumn Property="x => x.BackupDate" Title="Backup Date" Format="yyyy-MM-dd HH:mm:ss" />
            <PropertyColumn Property="x => x.TableCount" Title="Tables" />
            <PropertyColumn Property="x => x.TotalSizeBytes" Title="Size">
                <CellTemplate>
                    @FormatBytes(context.Item.TotalSizeBytes)
                </CellTemplate>
            </PropertyColumn>
            <TemplateColumn Title="Actions" CellClass="d-flex justify-end">
                <CellTemplate>
                    <MudStack Row="true" Spacing="1">
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                       Size="Size.Small"
                                       Color="Color.Primary"
                                       OnClick="() => SelectBackupSet(context.Item)"
                                       title="View Tables" />
                        @if (IsAdmin)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.RestorePage"
                                           Size="Size.Small"
                                           Color="Color.Warning"
                                           OnClick="() => RestoreBackupSetAsync(context.Item)"
                                           Disabled="@RestoreBusy"
                                           title="Restore All Tables From This Backup Set" />
                        }
                    </MudStack>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </MudDataGrid>
}

@if (_selectedBackupSet != null)
{
    <MudDivider Class="my-4" />

    <MudText Typo="Typo.subtitle1" Class="mb-2">Tables in Backup Set: @_selectedBackupSet.BackupDate.ToString("yyyy-MM-dd HH:mm:ss")</MudText>

    @if (_backupTables == null)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else if (_backupTables.Count == 0)
    {
        <MudAlert Severity="Severity.Warning">No tables found in this backup set</MudAlert>
    }
    else
    {
        <MudDataGrid T="BackupTableDto" Items="_backupTables" Dense="true" Style="width: auto; max-width: fit-content;">
            <Columns>
                <PropertyColumn Property="x => x.TableName" Title="Table Name" />
                <PropertyColumn Property="x => x.BlobName" Title="Blob Name" />
                <PropertyColumn Property="x => x.SizeBytes" Title="Size">
                    <CellTemplate>
                        @FormatBytes(context.Item.SizeBytes)
                    </CellTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.ExportedAt" Title="Exported At" Format="yyyy-MM-dd HH:mm:ss" />
            </Columns>
        </MudDataGrid>
    }
}

@if (_logMessages.Count > 0 || RestoreBusy)
{
    <MudDivider Class="my-4" />

    <MudStack Row="true" Spacing="2" Class="mb-2" AlignItems="AlignItems.Center">
        <MudText Typo="Typo.subtitle1">Restore Progress</MudText>
        @if (RestoreBusy)
        {
            <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Warning" />
        }
    </MudStack>

    <MudPaper Elevation="1" Class="pa-3" Style="background-color: #1e1e1e; max-height: 300px; overflow-y: auto; font-family: monospace; font-size: 0.85rem;">
        @foreach (var msg in _logMessages)
        {
            <div style="@GetLogLineStyle(msg)">@msg</div>
        }
        @if (RestoreBusy)
        {
            <div style="color: #569cd6;">...</div>
        }
    </MudPaper>
}

@code {
    private static string GetLogLineStyle(string msg)
    {
        if (msg.StartsWith("[") && msg.Contains("] ERROR:"))
            return "color: #f44747;";
        if (msg.StartsWith("[") && msg.Contains("] FATAL"))
            return "color: #f44747; font-weight: bold;";
        if (msg.StartsWith("[") && msg.Contains("] SKIPPED:"))
            return "color: #ce9178;";
        if (msg.StartsWith("[") && msg.Contains("] Imported "))
            return "color: #4ec9b0;";
        if (msg.StartsWith("[") && msg.Contains("completed successfully"))
            return "color: #4ec9b0; font-weight: bold;";
        return "color: #d4d4d4;";
    }
}
