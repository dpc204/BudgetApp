<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ScopedCssEnabled>true</ScopedCssEnabled>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RazorLangVersion>Latest</RazorLangVersion>
    <UserSecretsId>a0c2c5b7-5de1-4612-bd4e-43b30e547427</UserSecretsId>
    <StaticWebAssetBasePath>_content/Budget.Client</StaticWebAssetBasePath>
    <!-- Suppress compiler warnings from generated Razor files -->
    <NoWarn>$(NoWarn);CS8669;CS0414</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentResults" Version="4.0.0" />
    <PackageReference Include="Mapster" Version="9.0.0-pre01" />
    <PackageReference Include="MudBlazor" Version="9.4.0" />
    <PackageReference Include="Syncfusion.Blazor" Version="32.2.4" />
    <PackageReference Include="Syncfusion.Blazor.Themes" Version="32.2.4" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.3" />
  </ItemGroup>


  <ItemGroup>
    <ProjectReference Include="..\Budget.DB\Budget.DB.csproj" />
    <ProjectReference Include="..\Budget.Shared\Budget.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\js\" />
  </ItemGroup>

  <Target Name="IncludeScopedCssAsStaticWebAsset" AfterTargets="Build" DependsOnTargets="GenerateScopedCssFiles">
    <ItemGroup>
      <Content Include="$(IntermediateOutputPath)scopedcss\projectbundle\Budget.Client.bundle.scp.css">
        <Link>wwwroot\_content\Budget.Client\Budget.Client.bundle.scp.css</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </Content>
    </ItemGroup>
  </Target>

</Project>
