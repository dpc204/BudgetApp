{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }

  },
  "UseAzureDB": true,
  "HttpClient": {
    "TimeoutSeconds": 300
  },
  "CircuitOptions": {
    "DisconnectedCircuitMaxRetained": 100,
    "DisconnectedCircuitRetentionPeriod": 300
  },
  "Kestrel": {
    "Limits": {
      "RequestHeadersTimeoutMinutes": 5,
      "KeepAliveTimeoutMinutes": 5
    }
  }
}