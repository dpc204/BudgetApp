{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }

  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "Domain": "",
    "TenantId": "",
    "ClientId": "",
    "ClientSecret": "",
    "CallbackPath": "/signin-oidc",
    "SignedOutCallbackPath": "/signout-callback-oidc"
  },
  "UseAzureDB": false,
  "HttpClient": {
    "TimeoutSeconds": 300
  },
  "CircuitOptions": {
    "DisconnectedCircuitMaxRetained": 100,
    "DisconnectedCircuitRetentionPeriod": 300
  },
  "Kestrel": {
    "Limits": {
      "RequestHeadersTimeoutMinutes": 5,
      "KeepAliveTimeoutMinutes": 5
    }
  }
}