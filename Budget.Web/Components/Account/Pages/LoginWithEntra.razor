@page "/Account/LoginWithEntra"
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.OpenIdConnect

@inject NavigationManager NavigationManager

<PageTitle>Sign in</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudPaper Class="pa-8" Elevation="3">
        <MudText Typo="Typo.h4" Class="mb-4" Align="Align.Center">Sign in to FantumBudget</MudText>
        
        <MudText Typo="Typo.body1" Class="mb-6" Align="Align.Center">
            Use your Microsoft account to sign in
        </MudText>

        <MudButton 
            Variant="Variant.Filled" 
            Color="Color.Primary" 
            FullWidth="true"
            Size="Size.Large"
            StartIcon="@Icons.Material.Filled.Login"
            OnClick="SignInWithMicrosoft">
            Sign in with Microsoft
        </MudButton>

        <MudText Typo="Typo.caption" Class="mt-4" Align="Align.Center">
            Powered by Microsoft Entra ID
        </MudText>
    </MudPaper>
</MudContainer>

@code {
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private void SignInWithMicrosoft()
    {
        var returnUrl = ReturnUrl ?? "/";
        NavigationManager.NavigateTo($"/MicrosoftIdentity/Account/SignIn?redirectUri={Uri.EscapeDataString(returnUrl)}", forceLoad: true);
    }
}
