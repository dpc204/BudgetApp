<MudNavMenu>
  <AuthorizeView>
    <Authorized>
      <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Home</MudNavLink>
      <MudNavLink Href="envelopes" Icon="@Icons.Material.Filled.Folder">Envelopes</MudNavLink>
      <MudNavLink Href="assign" Icon="@Icons.Material.Filled.Folder">Assign</MudNavLink>
      <MudNavLink Href="budget" Icon="@Icons.Material.Filled.AccountBalance">Budget</MudNavLink>
      <MudNavLink Href="fund" Icon="@Icons.Material.Filled.AttachMoney">Fund</MudNavLink>
      <AuthorizeView Policy="AdminOnly" Context="adminContext">
        <Authorized>
          <MudNavGroup Title="Settings" Expanded="false">
            <MudNavLink Href="import" Icon="@Icons.Material.Filled.ImportExport">Import</MudNavLink>
            <MudNavLink Href="Maintenance" Icon="@Icons.Material.Filled.Build">Maintenance</MudNavLink>
            <MudNavLink Href="DBMaintenance" Icon="@Icons.Material.Filled.Build">DB Maintenance</MudNavLink>
          </MudNavGroup>
        </Authorized>
      </AuthorizeView>
      <AuthorizeView Policy="AdminOnly" Context="adminContext">
        <Authorized>
          <MudNavGroup Title="Admin" Icon="@Icons.Material.Filled.AdminPanelSettings" Expanded="false">
            <MudNavLink Href="admin/users" Icon="@Icons.Material.Filled.People">Users</MudNavLink>
            <MudNavLink Href="admin/roles" Icon="@Icons.Material.Filled.Shield">Roles</MudNavLink>
          </MudNavGroup>
        </Authorized>
      </AuthorizeView>
      
      <MudDivider Class="my-2" />
      
      <MudNavLink Href="Account/Manage" Icon="@Icons.Material.Filled.Person">
        @context.User.Identity?.Name
        @if (GetUserRole(context.User) is string role && !string.IsNullOrEmpty(role))
        {
          <MudChip T="string" Size="Size.Small" Color="GetRoleColor(role)" Class="ml-2">@role</MudChip>
        }
      </MudNavLink>

      <MudNavLink OnClick="@HandleLogoutAsync" Icon="@Icons.Material.Filled.Logout">Logout</MudNavLink>
    </Authorized>

    <NotAuthorized>
      <MudNavLink Href="MicrosoftIdentity/Account/SignIn" Icon="@Icons.Material.Filled.Login">Sign in with Microsoft</MudNavLink>
    </NotAuthorized>
    
    <Authorizing>
      <MudNavLink Disabled="true" Icon="@Icons.Material.Filled.HourglassEmpty">Loading...</MudNavLink>
    </Authorizing>
  </AuthorizeView>
</MudNavMenu>