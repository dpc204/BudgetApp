root = true

[BudgetApp/Budget.DB/Migrations/**.cs]
# Disable all analyzer diagnostics (IDE*, CA*, etc.) in this folder
# Note: This does not disable CSxxxx compiler warnings. Use <NoWarn> in the csproj if needed.
dotnet_analyzer_diagnostic.severity = none

# Silence specific compiler warnings in this folder
# CS8981: The type name only contains lower-cased ascii characters
dotnet_diagnostic.CS8981.severity = none
dotnet_diagnostic.IDE0079.severity = none

[*.cs]

# CA1873: Avoid potentially expensive logging
dotnet_diagnostic.CA1873.severity = none

# Disable xUnit1004: Test methods should not be skipped
dotnet_diagnostic.xUnit1004.severity = none

# Suppress all warnings for generated code (Blazor, Razor, etc.)
[**/*.{designer,generated,g}.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none
dotnet_diagnostic.CS8669.severity = none

[*.{razor.g.cs,cshtml.g.cs}]
generated_code = true
dotnet_analyzer_diagnostic.severity = none
dotnet_diagnostic.CS8669.severity = none

[**/obj/**/*.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none
dotnet_diagnostic.CS8669.severity = none

# Suppress CS8669 specifically for generated Razor files
[**/obj/**/Microsoft.CodeAnalysis.Razor.Compiler/**/*.cs]
dotnet_diagnostic.CS8669.severity = none

[**/obj/**/Microsoft.NET.Sdk.Razor.SourceGenerators.RazorSourceGenerator/**/*.cs]
dotnet_diagnostic.CS8669.severity = none
